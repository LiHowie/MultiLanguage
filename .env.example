# 只在服务端填写，禁止把本文件中的真实密钥打包到客户端。
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
SILICONFLOW_TEXT_MODEL=Qwen/Qwen3-8B
HOST=127.0.0.1
PORT=8797
DATABASE_PATH=.runtime/modo.sqlite
# 部署时填写反向代理后的主机名和允许的网页来源。
ALLOWED_HOSTS=
ALLOWED_ORIGINS=
# 明确开启后，受信任的运营人员才可在本机 CLI 开通测试会员。
MODO_TEST_MODE=0
